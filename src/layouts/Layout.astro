---
import "~/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import CookieConsent from "~/components/CookieConsent.astro";
const { pageTitle, title, description } = Astro.props;
const baseUrl = `${Astro.url.protocol}//${Astro.url.host}`;
import { siteLang, themeColor } from "~/data/config";
---

<!doctype html>
<html lang={siteLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={themeColor} />
		<meta name="description" content="Kytka z Beskyd - kytice, sušené věnce a dekorace, svatební floristika a zahradní tvorba. Květiny tvořené srdcem, inspirované přírodou." />
		<meta name="robots" content="index,follow" />
		<meta name="googlebot" content="index,follow" />
		<link rel="author" href="humans.txt" />

		<meta name="msapplication-TileColor" content="#ffffff" />

		<meta property="og:url" content={Astro.url} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Kytka z Beskyd | Květiny tvořené srdcem" />
		<meta property="og:image" content={`${baseUrl}/flowers/157b55da-b44f-4e52-ae33-42be1a7b0df9.jpeg`} />
		<meta property="og:description" content="Kytice, sušené věnce a dekorace, svatební floristika a zahradní tvorba - ručně tvořeno v Beskydech." />
		<meta property="og:site_name" content="Kytka z Beskyd" />
		<meta property="og:locale" content="cs_CZ" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content="Kytka z Beskyd | Květiny tvořené srdcem" />
		<meta name="twitter:description" content="Kytice, sušené věnce a dekorace, svatební floristika a zahradní tvorba - ručně tvořeno v Beskydech." />
		<meta name="twitter:image" content={`${baseUrl}/flowers/157b55da-b44f-4e52-ae33-42be1a7b0df9.jpeg`} />

		<link rel="icon" type="image/x-icon" href="/favicon-logo.ico" />
		<link rel="shortcut icon" type="image/x-icon" href="/favicon-logo.ico" />

		<title>Kytka z Beskyd | Květiny tvořené srdcem</title>
		<ClientRouter />		
		<CookieConsent />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
