---
import { menuMain } from "~/data/menus.js";
import { socialMedia } from "~/data/config";

const rmTrailingSlash = (path: string): string => {
  return path.endsWith("/") && path.length > 1
    ? path.slice(0, path.length - 1)
    : path;
}

const pathname = rmTrailingSlash(Astro.url.pathname);
---

<header class="bg-cream" x-data="{ open: false }" @keydown.window.escape="open = false">
  <div class="container py-4 md:py-6">
    <nav class="flex items-center justify-between gap-4" aria-label="Global">
      <a href="/" class="shrink-0 inline-flex items-center justify-center rounded-full border border-ink-green size-16 md:size-20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green" aria-label="Kytka z Beskyd - domů">
        <span class="font-script text-ink-green text-base md:text-lg leading-none text-center px-1">Kytka z Beskyd</span>
      </a>

      <div class="flex lg:hidden">
        <button
          type="button"
          class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green"
          @click="open = true"
        >
          <span class="sr-only">Otevřít hlavní menu</span>
          <svg
            class="size-8 text-ink-green"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
            data-slot="icon"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
        </button>
      </div>

      <div class="hidden lg:flex lg:gap-x-8 lg:items-center">
        {
          menuMain.map((item) => (
            <a
              href={item.url}
              class:list={[
                "font-body uppercase tracking-[0.12em] text-sm text-ink-green transition pb-1 border-b-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green",
                pathname === item.url ? "border-accent-pink" : "border-transparent hover:border-accent-pink-soft",
              ]}
            >
              {item.name}
            </a>
          ))
        }
      </div>

      <div class="hidden lg:flex items-center gap-2 shrink-0">
        <a
          href={socialMedia.facebook.url}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-ink-green hover:text-accent-pink-deep transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green"
          aria-label="Facebook Kytka z Beskyd"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"></path>
          </svg>
        </a>
        <a
          href={socialMedia.instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-ink-green hover:text-accent-pink-deep transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green"
          aria-label="Instagram Kytka z Beskyd"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
          </svg>
        </a>
      </div>
    </nav>

    <div class="lg:hidden" x-ref="dialog" x-show="open" x-cloak role="dialog" aria-modal="true" aria-label="Hlavní menu">
      <div
        class="fixed inset-0 z-50 w-full overflow-y-auto bg-cream px-8 py-6"
        x-show="open"
        x-transition:enter="transition ease-out"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        x-cloak
      >
        <div class="flex items-center justify-between">
          <a href="/" class="inline-flex items-center justify-center rounded-full border border-ink-green size-16 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green" aria-label="Kytka z Beskyd - domů" @click="open = false">
            <span class="font-script text-ink-green text-base leading-none text-center px-1">Kytka z Beskyd</span>
          </a>
          <button type="button" class="-m-2.5 p-2.5 text-ink-green focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green" @click="open = false">
            <span class="sr-only">Zavřít menu</span>
            <svg
              class="size-8"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              aria-hidden="true"
              data-slot="icon"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="mt-6 flow-root">
          <div class="-my-6 divide-y divide-ink-green/10">
            <div class="space-y-2 py-6 mt-16">
              {
                menuMain.map((item) => (
                  <a
                    @click="open = false"
                    href={item.url}
                    class:list={[
                      "block py-2 text-center font-body uppercase tracking-[0.1em] text-2xl text-ink-green focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green",
                      pathname === item.url ? "font-bold text-accent-pink-deep" : "",
                    ]}
                  >
                    {item.name}
                  </a>
                ))
              }
            </div>
            <div class="flex items-center justify-center gap-6 py-6">
              <a
                href={socialMedia.facebook.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 text-ink-green focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green"
                aria-label="Facebook Kytka z Beskyd"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"></path>
                </svg>
              </a>
              <a
                href={socialMedia.instagram.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 text-ink-green focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green"
                aria-label="Instagram Kytka z Beskyd"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
