---
const currentYear = new Date().getFullYear();
import { siteName, phone, email, socialMedia } from "~/data/config";

const badges = [
  {
    title: "Čerstvé a sezónní",
    body: "Pracuji s květinami, které jsou právě v sezóně.",
  },
  {
    title: "Ruční práce",
    body: "Každou kytici nebo dekoraci vytvářím s láskou a pečlivostí.",
  },
  {
    title: "Lokálně z Beskyd",
    body: "Inspiraci čerpám z přírody kolem nás.",
  },
  {
    title: "Osobní přístup",
    body: "Ráda s vámi vše proberu a poradím.",
  },
];
---

<footer>
  <div class="bg-blush">
    <div class="container py-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {badges.map((badge, i) => (
          <div class="flex flex-col items-center text-center gap-3">
            {i === 0 && (
              <svg xmlns="http://www.w3.org/2000/svg" class="size-8 text-ink-green" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c-3-2-9-6.5-9-12A5 5 0 0 1 12 6a5 5 0 0 1 9 3c0 5.5-6 10-9 12Z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21V9"></path>
              </svg>
            )}
            {i === 1 && (
              <svg xmlns="http://www.w3.org/2000/svg" class="size-8 text-ink-green" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 15v-6.75A2.25 2.25 0 0 1 9.75 6v0a2.25 2.25 0 0 1 2.25 2.25V15m0-4.5v-1.5A2.25 2.25 0 0 1 14.25 6.75v0A2.25 2.25 0 0 1 16.5 9v6m0-4.5A2.25 2.25 0 0 1 18.75 12.75v3a6 6 0 0 1-6 6h-1.5a6 6 0 0 1-5.196-3l-1.72-2.978a1.299 1.299 0 0 1 2.127-1.482L7.5 15"></path>
              </svg>
            )}
            {i === 2 && (
              <svg xmlns="http://www.w3.org/2000/svg" class="size-8 text-ink-green" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"></path>
              </svg>
            )}
            {i === 3 && (
              <svg xmlns="http://www.w3.org/2000/svg" class="size-8 text-ink-green" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-1a4 4 0 0 0-3-3.87M9 20H4v-1a4 4 0 0 1 3-3.87m5-3.13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7-2a2.5 2.5 0 1 1-3.163-2.415M6.163 9.585A2.5 2.5 0 1 0 9 7"></path>
              </svg>
            )}
            <h3 class="font-display text-ink-green text-2xl">{badge.title}</h3>
            <p class="font-body text-ink-body text-sm">{badge.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="bg-footer-dark">
    <div class="container py-10">
      <div class="flex flex-col items-center gap-6 text-center">
        <p class="font-script text-accent-pink text-4xl md:text-5xl flex items-center gap-2">
          Děkuji za vaši důvěru
          <svg xmlns="http://www.w3.org/2000/svg" class="size-7 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"></path>
          </svg>
        </p>

        <div class="flex flex-wrap items-center justify-center gap-6 font-body text-cream text-sm">
          <a href={phone.href} class="hover:text-blush transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream">{phone.label}</a>
          <a href={email.href} class="hover:text-blush transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream">{email.label}</a>
        </div>

        <div class="flex items-center gap-4">
          <a
            href={socialMedia.facebook.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-blush hover:text-cream transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
            aria-label="Facebook Kytka z Beskyd"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"></path>
            </svg>
          </a>
          <a
            href={socialMedia.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-blush hover:text-cream transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
            aria-label="Instagram Kytka z Beskyd"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
            </svg>
          </a>
        </div>

        <p class="font-body text-cream text-sm">
          &copy; {currentYear} {siteName}. Všechna práva vyhraná.
          <a class="underline hover:text-blush transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream" href="/privacy-policy">Zásady ochrany osobních údajů</a>
        </p>
      </div>
    </div>
  </div>
</footer>
