---
---

<form action="#">
    <div class="flex flex-col gap-8 mx-auto max-w-md font-body">
        <div>
            <label for="name" class="text-ink-green">Jméno</label>
            <div class="mt-2">
                <input type="text" name="name" id="name" required />
            </div>
        </div>

        <div>
            <label for="email" class="text-ink-green">Email</label>
            <div class="mt-2 grid grid-cols-1">
                <input type="email" name="email" id="email" placeholder="vy@example.com" required />
            </div>
        </div>

        <div>
            <label for="message" class="text-ink-green">Zpráva</label>
            <div class="mt-2">
                <textarea name="message" id="message" rows="4" required></textarea>
            </div>
        </div>

        <div>
            <button
                type="submit"
                class="inline-flex items-center rounded-sm px-4 py-3 text-sm font-body font-semibold uppercase tracking-[0.1em] bg-accent-pink-deep text-white transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-pink-deep"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="size-5 -rotate-45 -mt-1 inline-block mr-1"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
                    ></path>
                </svg>
                Odeslat
            </button>
        </div>
    </div>
</form>
