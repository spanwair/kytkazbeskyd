---
interface Props {
  image: string;
  alt: string;
  title: string;
  subtitle?: string;
  body: string;
  href: string;
}

const { image, alt, title, subtitle, body, href } = Astro.props as Props;
---

<article class="flex flex-col h-full bg-cream-card rounded-sm overflow-hidden">
  <div class="aspect-[4/5] w-full overflow-hidden">
    <img src={image} alt={alt} class="w-full h-full object-cover rounded-t-sm" loading="lazy" />
  </div>
  <div class="flex flex-col flex-1 gap-2 p-5">
    <slot />
    <h3 class="font-display text-ink-green text-2xl!">{title}</h3>
    {subtitle && <p class="font-body text-ink-body text-sm -mt-1">{subtitle}</p>}
    <p class="font-body text-ink-body text-sm leading-relaxed flex-1">{body}</p>
    <a
      href={href}
      class="mt-2 inline-flex items-center gap-2 text-accent-pink-deep font-body text-sm uppercase tracking-[0.1em] w-max focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-pink-deep"
      aria-label={`Zobrazit více: ${title}`}
    >
      Zobrazit více
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"></path>
      </svg>
    </a>
  </div>
</article>
