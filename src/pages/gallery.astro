---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import { socialMedia } from "~/data/config";
import catalog from "../../public/flowers-catalog.json";

// Page copy for each category, keyed by the site-wide nav/anchor slug
// (e.g. `#kytice`). The photo list itself is derived below from
// `public/flowers-catalog.json` (the source of truth for the photos in
// `public/flowers/`) so the two never drift apart.
interface GalleryCategory {
	slug: string;
	title: string;
	intro: string;
}

const galleryCategories: GalleryCategory[] = [
	{
		slug: "kytice",
		title: "Kytice",
		intro: "Čerstvé, sezónní kytice - pokaždé trochu jiné.",
	},
	{
		slug: "vence-a-dekorace",
		title: "Sušené květiny a věnce",
		intro: "Ručně vázané věnce a dekorace, které vydrží.",
	},
	{
		slug: "svatby",
		title: "Svatební floristika",
		intro: "Kytice, korsáže a výzdoba pro váš velký den.",
	},
	{
		slug: "zahrady",
		title: "Zahrady a výsadby",
		intro: "Návrhy, osazování a péče o zahrady.",
	},
	{
		slug: "doplnky",
		title: "Doplňky",
		intro: "Korsáže, ozdoby do vlasů a další drobné detaily.",
	},
];

// Maps `flowers-catalog.json` category labels to the site's nav/anchor
// slugs above. Catalog categories with no entry here (e.g. "galerie
// tvorby", "portret kvetinarky") don't have a gallery section and are
// dropped.
const categorySlugByCatalogCategory: Record<string, string> = {
	"kytice - kytice z cerstvych kvetin": "kytice",
	"sušené květiny a věnce": "vence-a-dekorace",
	"svatební floristika": "svatby",
	"zahrady a vysadby": "zahrady",
	"doplnky - korsaze/ozdoby do vlasu": "doplnky",
};

// A few `alt_text_cs` strings in the catalog contain AI-generated language
// errors (see docs/redesign/disclaimers.md section (d)); these
// hand-corrections match what's already shipped on the homepage.
const altOverrides: Record<string, string> = {
	"18ef0981-1389-43a7-b918-2546a229fa74.jpeg":
		"Rustikální sušený květinový věnec s muchornicemi a osušeným listím.",
	"74d78256-be34-4ad7-8b51-a3d8cc7f31ba.jpeg":
		"Rustikální věnec z purpurové a modré květiny a zeleně.",
	"e267356c-9f76-447f-98da-1bc2562535e4.jpeg":
		"Rustikální květinový okras z sušených květin v purpurových a růžových odstínech.",
	"7f8f3457-17db-4f52-bf2e-1e5493235670.jpeg":
		"Oranžové a modré korsáže na kamenné ploše pro svatební doplňky.",
};

interface GalleryItem {
	filename: string;
	alt: string;
	category: string;
}

const galleryItems: GalleryItem[] = catalog.images.flatMap((image): GalleryItem[] => {
	const category = categorySlugByCatalogCategory[image.category];
	if (!category) return [];

	return [
		{
			filename: image.filename,
			alt: altOverrides[image.filename] ?? image.alt_text_cs,
			category,
		},
	];
});

const itemsByCategory = (slug: string) => galleryItems.filter((item) => item.category === slug);

let firstEagerRendered = false;

function ctaHref(alt: string) {
  return `/book?message=${encodeURIComponent("Zajímá mě: " + alt)}#email-form`;
}

const priceTiers = [
  { size: "Malý 15-25 cm", price: "190-320 Kč" },
  { size: "Střední 25-35 cm", price: "380-680 Kč" },
  { size: "Větší 36-46 cm", price: "580-880 Kč" },
  { size: "Nad 55 cm", price: "od 1100 Kč" },
];
---

<Layout
	title="Galerie | Kytka z Beskyd"
	pageTitle="Galerie"
	description="Galerie kytic, sušených věnců, svatební floristiky a doplňků z dílny Kytka z Beskyd."
>
	<Section id="galerie-uvod" class:list="bg-cream">
		<h1 class="font-display font-bold text-ink-green tracking-[0.04em] text-4xl lg:text-6xl">Galerie</h1>
		<p class="mt-4 max-w-2xl font-body text-ink-body leading-relaxed">
			<strong>Nechte se inspirovat naší tvorbou.</strong><br />
			Kytice, sušené věnce a dekorace, svatební floristika i drobné doplňky - ručně tvořeno v Beskydech.
		</p>

		<div class="mt-8 max-w-xl rounded-sm bg-cream-card px-6 py-5">
			<h2 class="font-display text-ink-green text-xl">Orientační ceny věnců</h2>
			<dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 font-body text-sm text-ink-body">
				{
					priceTiers.map((tier) => (
						<>
							<dt>{tier.size}</dt>
							<dd class="text-right font-semibold text-accent-pink-deep">{tier.price}</dd>
						</>
					))
				}
			</dl>
		</div>
	</Section>

	{
		galleryCategories.map((category: GalleryCategory, sectionIndex) => {
			const items = itemsByCategory(category.slug);
			const bgClass = sectionIndex % 2 === 0 ? "bg-cream-alt" : "bg-cream";

			return (
				<Section id={category.slug} class:list={bgClass}>
					<h2 class="flex items-center gap-3 font-script font-normal! text-ink-green text-4xl lg:text-5xl">
						{category.title}
						<svg xmlns="http://www.w3.org/2000/svg" class="size-7 shrink-0 text-accent-pink-soft" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
						</svg>
					</h2>
					<p class="mt-2 font-body text-ink-body">{category.intro}</p>

					{items.length > 0 ? (
						<div class="mt-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
							{items.map((item) => {
								const imagePath = `/flowers/${item.filename}`;
								const eager = !firstEagerRendered;
								if (eager) firstEagerRendered = true;

								return (
									<div class="group relative aspect-square overflow-hidden rounded-sm bg-cream-card">
										<a
											href={imagePath}
											class="glightbox absolute inset-0 block"
											data-gallery={category.slug}
											data-title={item.alt}
											aria-label={`Zvětšit fotografii: ${item.alt}`}
										>
											<img
												src={imagePath}
												alt={item.alt}
												class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
												loading={eager ? "eager" : "lazy"}
												fetchpriority={eager ? "high" : "auto"}
											/>
										</a>
										<div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-ink-green/70 to-transparent" aria-hidden="true" />
										<a
											href={ctaHref(item.alt)}
											class="absolute inset-x-2 bottom-2 z-10 rounded-sm bg-accent-pink-deep px-2 py-2 text-center text-[11px] sm:text-xs font-body font-semibold uppercase tracking-[0.08em] text-white transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
										>
											Objednat tento výrobek
										</a>
									</div>
								);
							})}
						</div>
					) : (
						<div class="mt-8 rounded-sm border border-dashed border-ink-green/30 bg-cream-card px-6 py-10 text-center">
							<p class="font-body text-ink-body leading-relaxed max-w-xl mx-auto">
								Fotografie z našich zahradních realizací připravujeme - mrkněte na nás na Instagramu, nebo se zeptejte přímo.
							</p>
							<div class="mt-6 flex flex-wrap items-center justify-center gap-4">
								<a
									href={socialMedia.instagram.url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center rounded-sm px-4 py-3 text-sm font-body font-semibold uppercase tracking-[0.1em] border border-ink-green text-ink-green transition hover:bg-ink-green hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-green"
								>
									Sledovat na Instagramu
								</a>
								<a
									href="/contact"
									class="inline-flex items-center rounded-sm px-4 py-3 text-sm font-body font-semibold uppercase tracking-[0.1em] bg-accent-pink-deep text-white transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-pink-deep"
								>
									Zeptat se přímo
								</a>
							</div>
						</div>
					)}
				</Section>
			);
		})
	}
</Layout>

<script>
	import GLightbox from "glightbox";
	import "../../node_modules/glightbox/dist/css/glightbox.min.css";

	document.addEventListener("astro:page-load", () => {
		const lightbox = GLightbox({
			touchNavigation: true,
			autoplayVideos: true,
			loop: true,
			draggable: true,
		});
	});
</script>
